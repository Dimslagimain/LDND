generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Aircraft {
  id           String    @id @default(uuid()) @db.Char(36)
  acType       String    @map("ac_type") @db.VarChar(100)
  acTypeGroup  String    @map("ac_type_group") @db.VarChar(50)
  registration String    @unique @db.VarChar(20)
  airline      String    @db.VarChar(20)
  createdAt    DateTime? @default(now()) @map("created_at")

  carpetItems  CarpetItem[]

  @@map("aircraft")
}

model CarpetItem {
  id             String    @id @default(uuid()) @db.Char(36)
  aircraftId     String    @map("aircraft_id") @db.Char(36)
  carpetType     String    @map("carpet_type") @db.VarChar(50)
  intervalMonths Int       @map("interval_months")
  lastDone       DateTime? @map("last_done") @db.Date
  nextDue        DateTime? @map("next_due") @db.Date
  remark         String?   @db.VarChar(50)
  acStatus       String?   @default("ACTIVE") @map("ac_status") @db.VarChar(20)
  vendor         String?   @db.VarChar(50)
  coatroom       String?   @db.VarChar(50)
  createdAt      DateTime? @default(now()) @map("created_at")

  aircraft           Aircraft             @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  replacementHistory ReplacementHistory[]

  @@unique([aircraftId, carpetType])
  @@index([aircraftId])
  @@index([nextDue])
  @@map("carpet_items")
}

model ReplacementHistory {
  id           String    @id @default(uuid()) @db.Char(36)
  carpetItemId String    @map("carpet_item_id") @db.Char(36)
  doneNumber   Int       @map("done_number")
  doneDate     DateTime  @map("done_date") @db.Date
  isPremature  Boolean   @default(false) @map("is_premature")
  createdAt    DateTime? @default(now()) @map("created_at")

  carpetItem CarpetItem @relation(fields: [carpetItemId], references: [id], onDelete: Cascade)

  @@index([carpetItemId])
  @@map("replacement_history")
}

model RawmatQty {
  id        String    @id @default(uuid()) @db.Char(36)
  airline   String    @unique @db.VarChar(50)
  qty       Float     @default(0)
  unit      String    @default("YD") @db.VarChar(50)
  updatedAt DateTime? @updatedAt @map("updated_at")
  createdAt DateTime? @default(now()) @map("created_at")

  @@map("rawmat_qty")
}

model CarpetIntervalMaster {
  id          String @id @default(uuid()) @db.Char(36)
  acTypeGroup String @map("ac_type_group") @db.VarChar(50)
  carpetType  String @map("carpet_type") @db.VarChar(50)
  interval    Int

  @@unique([acTypeGroup, carpetType])
  @@map("carpet_interval_master")
}
